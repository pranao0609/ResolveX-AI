# ─────────────────────────────────────────────────────────────────────────────
# ResolveX-AI — Environment Configuration Example Template
# Copy this to .env and fill in your values. NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Application Environment
APP_NAME=ResolveX-AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origin URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB=postgres
RDS_USER=postgres
RDS_PASSWORD=your_database_password_here
RDS_SSL=False

# Groq Cloud LLM Configuration (get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2

# Confidence Decision Thresholds (0.0 to 1.0)
AUTO_RESOLVE_THRESHOLD=0.75
HITL_THRESHOLD=0.50

# File Storage Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# FAISS Vector Index Storage
FAISS_INDEX_PATH=data/faiss/index.faiss
FAISS_DOCSTORE_PATH=data/faiss/docstore.json

# LangSmith Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ResolveX
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# MLflow MLOps Experiment Tracking
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ResolveX
MLFLOW_RUN_NAME=

